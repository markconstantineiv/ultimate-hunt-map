{
  "version": 8,
  "name": "Ultimate Hunt",
  "sources": {
    "usgs-topo": {
      "type": "raster",
      "tiles": [
        "https://basemap.nationalmap.gov/arcgis/rest/services/USGSTopo/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 16,
      "attribution": "USGS The National Map"
    },
    "satellite": {
      "type": "raster",
      "tiles": [
        "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=jpg&transparent=false&f=image"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 19,
      "attribution": "Esri World Imagery"
    },
    "lidar-hillshade": {
      "type": "raster",
      "tiles": [
        "https://gis.dnr.wa.gov/site1/rest/services/Public_Geology/Lidar_Hillshade/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=false&layers=show:1&f=image"
      ],
      "tileSize": 256,
      "minzoom": 8,
      "maxzoom": 19,
      "attribution": "Washington Geological Survey bare-earth lidar hillshade"
    },
    "land-manager": {
      "type": "raster",
      "tiles": [
        "https://gis.blm.gov/arcgis/rest/services/lands/BLM_Natl_SMA_Cached_without_PriUnk/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 15,
      "attribution": "BLM Surface Management Agency"
    },
    "mvum": {
      "type": "raster",
      "tiles": [
        "https://apps.fs.usda.gov/arcx/services/EDW/EDW_MVUM_01/MapServer/WMSServer?service=WMS&request=GetMap&version=1.1.1&layers=1,2&styles=&format=image/png&transparent=true&srs=EPSG:3857&bbox={bbox-epsg-3857}&width=256&height=256"
      ],
      "tileSize": 256,
      "minzoom": 8,
      "maxzoom": 18,
      "attribution": "USDA Forest Service MVUM"
    },
    "wdfw-access": {
      "type": "raster",
      "tiles": [
        "https://geodataservices.wdfw.wa.gov/arcgis/rest/services/MapServices/HOPubMapService1/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=true&layers=show:0,1,2,3&f=image"
      ],
      "tileSize": 256,
      "minzoom": 7,
      "maxzoom": 18,
      "attribution": "Washington Department of Fish and Wildlife"
    },
    "wdfw-land": {
      "type": "raster",
      "tiles": [
        "https://geodataservices.wdfw.wa.gov/arcgis/rest/services/WP_RealEstate/WildlifeAreas/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=true&layers=show:0,1&f=image"
      ],
      "tileSize": 256,
      "minzoom": 6,
      "maxzoom": 18,
      "attribution": "Washington Department of Fish and Wildlife"
    },
    "gmu": {
      "type": "raster",
      "tiles": [
        "https://geodataservices.wdfw.wa.gov/arcgis/rest/services/MapServices/HOReferenceService/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=true&layers=show:0&f=image"
      ],
      "tileSize": 256,
      "minzoom": 5,
      "maxzoom": 18,
      "attribution": "Washington Department of Fish and Wildlife"
    }
  },
  "layers": [
    {
      "id": "usgs-topo",
      "type": "raster",
      "source": "usgs-topo",
      "minzoom": 0,
      "maxzoom": 17
    },
    {
      "id": "satellite-layer",
      "type": "raster",
      "source": "satellite",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 1.0
      }
    },
    {
      "id": "lidar-hillshade-layer",
      "type": "raster",
      "source": "lidar-hillshade",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 1.0,
        "raster-contrast": 0.22,
        "raster-brightness-min": 0.05,
        "raster-brightness-max": 0.95
      }
    },
    {
      "id": "land-manager-layer",
      "type": "raster",
      "source": "land-manager",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 0.45
      }
    },
    {
      "id": "wdfw-land-layer",
      "type": "raster",
      "source": "wdfw-land",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 0.6
      }
    },
    {
      "id": "wdfw-access-layer",
      "type": "raster",
      "source": "wdfw-access",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 0.95
      }
    },
    {
      "id": "gmu-layer",
      "type": "raster",
      "source": "gmu",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 0.95
      }
    },
    {
      "id": "mvum-layer",
      "type": "raster",
      "source": "mvum",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 0.95
      }
    }
  ]
}
